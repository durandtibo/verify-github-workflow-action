    "expect": "success",
    "markers": "none",
    "released": false
  },
  {
    "id": "custom-paths-versions-flags",
    "inputs": {
      "paths": ".github/workflows/ci.yaml\n.github/workflows/ci-action.yaml",
      "actionlint-version": "1.7.12",
      "actionlint-flags": "-format '{{json .}}'",
      "zizmor-version": "1.31.1",
      "zizmor-flags": "--no-progress"
    },
    "expect": "success",
    "markers": "both",
    "released": false
  },
  {
    "id": "latest-versions-and-format",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml",
      "actionlint-version": "latest",
      "zizmor-version": "latest",
      "zizmor-flags": "--format=plain --no-progress"
    },
    "expect": "success",
    "markers": "both",
    "released": false
  },
  {
    "id": "exact-actionlint-version",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml",
      "zizmor": "false",
      "actionlint-version": "1.7.11"
    },
    "expect": "success",
    "markers": "actionlint",
    "actionlint-version": "1.7.11",
    "released": false
  },
  {
    "id": "unknown-actionlint-version",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml",
