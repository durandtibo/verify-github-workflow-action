    },
    "expect": "success",
    "markers": "actionlint",
    "released": false
  },
  {
    "id": "both-errors-both-tools-run",
    "inputs": {
      "paths": "tests/fixtures/actionlint-error.yaml\ntests/fixtures/zizmor-error.yaml"
    },
    "expect": "failure",
    "markers": "both",
    "released": false,
    "os": "matrix"
  },
  {
    "id": "all-disabled",
    "inputs": {
