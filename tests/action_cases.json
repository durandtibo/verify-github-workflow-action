[
  {
    "id": "valid-fixture",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml"
    },
    "expect": "success",
    "markers": "both",
    "released": false
  },
  {
    "id": "invalid-actionlint-boolean",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml",
      "actionlint": "yes"
    },
    "expect": "failure",
    "markers": "none",
    "released": false
  },
  {
    "id": "invalid-zizmor-boolean",
    "inputs": {
      "paths": "tests/fixtures/valid/ok.yaml",
      "zizmor": "yes"
    },
    "expect": "failure",
    "markers": "none",
    "released": false
  },
  {
    "id": "actionlint-error-caught",
    "inputs": {
      "paths": "tests/fixtures/actionlint-error.yaml"
    },
    "expect": "failure",
    "markers": "both",
    "released": false,
    "os": "matrix"
  },
  {
    "id": "actionlint-error-actionlint-disabled",
    "inputs": {
      "paths": "tests/fixtures/actionlint-error.yaml",
      "actionlint": "false"
    },
    "expect": "success",
    "markers": "zizmor",
    "released": false
  },
  {
    "id": "zizmor-error-caught",
    "inputs": {
      "paths": "tests/fixtures/zizmor-error.yaml"
    },
    "expect": "failure",
    "markers": "both",
    "released": false,
    "os": "matrix"
  },
  {
    "id": "zizmor-error-zizmor-disabled",
